# Copy to .env (git-ignored) and fill in. Used by scout_bot.py.
# Scout Bot Discord app: discord.com/developers > Applications > Scout Bot
SCOUT_BOT_APPLICATION_ID=your-scout-bot-application-id
SCOUT_BOT_TOKEN=your-scout-bot-token
# LD2L server and channel the bot posts to (Developer Mode > right-click > Copy ID)
SCOUT_BOT_GUILD_ID=
SCOUT_BOT_CHANNEL_ID=
# Optional RD2L server and its report channel (RD2L teams only). A team selection is required there.
SCOUT_BOT_EXTRA_GUILD_ID=
SCOUT_BOT_EXTRA_CHANNEL_ID=
