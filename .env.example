# Copy to .env (git-ignored) and fill in. Used by scout_bot.py.
# Scout Bot Discord app: discord.com/developers > Applications > Scout Bot
SCOUT_BOT_APPLICATION_ID=your-scout-bot-application-id
SCOUT_BOT_TOKEN=your-scout-bot-token
# Server and channel the bot posts to (Developer Mode > right-click > Copy ID)
SCOUT_BOT_GUILD_ID=
SCOUT_BOT_CHANNEL_ID=
